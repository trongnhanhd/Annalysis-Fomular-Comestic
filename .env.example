# Local development only. Replace with a strong value; no @, colon or / unless URL-encoded.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# R3 local-prototype authentication (opt-in; DO NOT expose disabled mode publicly):
RND_AUTH_MODE=disabled
RND_AUTH_DB_PATH=var/auth_r3.sqlite3
RND_AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set true when serving over HTTPS in a controlled environment.
RND_AUTH_COOKIE_SECURE=false
